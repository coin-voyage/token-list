{
  "name": "@coinvoyage/token-list",
  "version": "1.0.0",
  "description": "Single source of truth for supported chains and tokens; tokenlist.json is consumable via GitHub raw URL",
  "packageManager": "pnpm@9.15.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coin-voyage/token-list.git"
  },
  "keywords": [
    "coin-voyage",
    "token",
    "list"
  ],
  "license": "MIT",
  "scripts": {
    "validate": "node scripts/validate.mjs",
    "verify:onchain": "node scripts/verify-onchain.mjs",
    "build:tokenlist": "node scripts/build-tokenlist.mjs",
    "build:tokenlist:preview": "node scripts/build-tokenlist.mjs --preview",
    "build": "node scripts/build-tokenlist.mjs && node scripts/build-tokenlist.mjs --preview"
  }
}
